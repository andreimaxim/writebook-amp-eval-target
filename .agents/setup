#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# The benchmark's original sandbox uses /app, and one infrastructure task
# intentionally refers to that absolute path.
if [[ ! -e /app ]]; then
  sudo ln -s "$repo_root" /app
elif [[ "$(readlink -f /app)" != "$repo_root" ]]; then
  echo "/app exists but does not point to $repo_root" >&2
  exit 1
fi

packages=(
  build-essential
  ca-certificates
  curl
  git
  libcgif-dev
  libexpat1-dev
  libglib2.0-dev
  libgmp-dev
  libheif-dev
  libimagequant-dev
  libjpeg62-turbo-dev
  libpng-dev
  libssl-dev
  libtiff-dev
  libwebp-dev
  libyaml-dev
  meson
  ninja-build
  pkg-config
  xz-utils
  zlib1g-dev
)

missing=()
for package in "${packages[@]}"; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'ok installed'; then
    missing+=("$package")
  fi
done

if (( ${#missing[@]} )); then
  echo "Installing system packages: ${missing[*]}"
  sudo apt-get update -qq
  sudo apt-get install --no-install-recommends -y "${missing[@]}"
fi

# Debian 12 ships libvips 8.14.1, whose loader discovery ignores the blocked
# flags used by Writebook's security policy. Build the same 8.16.1 release as
# the benchmark image, without the optional Magick and SVG loaders the app
# deliberately blocks.
vips_version="8.16.1"
installed_vips="$(pkg-config --modversion vips 2>/dev/null || true)"
if [[ "$installed_vips" != "$vips_version" ]]; then
  source_archive="$HOME/.cache/vips-$vips_version.tar.xz"
  source_dir="$HOME/.cache/vips-$vips_version"
  mkdir -p "$HOME/.cache"

  if [[ ! -f "$source_archive" ]]; then
    echo "Downloading libvips $vips_version..."
    curl -fsSL \
      "https://github.com/libvips/libvips/releases/download/v$vips_version/vips-$vips_version.tar.xz" \
      -o "$source_archive"
  fi
  echo "d114d7c132ec5b45f116d654e17bb4af84561e3041183cd4bfd79abfb85cf724  $source_archive" |
    sha256sum --check --status

  rm -rf "$source_dir"
  mkdir -p "$source_dir"
  tar -C "$source_dir" --strip-components=1 -xf "$source_archive"

  echo "Building libvips $vips_version..."
  meson setup "$source_dir/build" "$source_dir" \
    --prefix=/usr/local \
    --libdir=lib \
    --buildtype=release \
    -Dintrospection=disabled \
    -Dcplusplus=false \
    -Ddeprecated=false \
    -Dexamples=false \
    -Dmagick=disabled \
    -Drsvg=disabled \
    -Dspng=disabled \
    -Dheif-module=disabled
  meson compile -C "$source_dir/build"
  sudo meson install -C "$source_dir/build"
  sudo ldconfig
  rm -rf "$source_dir"
fi

[[ "$(pkg-config --modversion vips)" == "$vips_version" ]] || {
  echo "libvips $vips_version is not active" >&2
  exit 1
}

if [[ ! -x "$HOME/.local/bin/mise" ]]; then
  echo "Installing mise..."
  curl -fsSL https://mise.run | sh
fi

export PATH="$HOME/.local/bin:$PATH"
mise trust --yes "$repo_root/mise.toml"

echo "Installing Ruby..."
mise install --yes --cd "$repo_root"

profile_marker="# Writebook orb toolchain"
touch "$HOME/.bash_profile"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile"; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# Writebook orb toolchain
if [[ -x "$HOME/.local/bin/mise" ]]; then
  eval "$("$HOME/.local/bin/mise" activate bash)"
fi
EOF
fi

cd "$repo_root"
echo "Installing gems..."
mise exec -- gem install bundler -v 2.5.18 --no-document
mise exec -- bundle _2.5.18_ install

echo "Preparing the test database..."
rm -f storage/db/test.sqlite3 storage/db/test.sqlite3-*
mise exec -- env RAILS_ENV=test bin/rails db:prepare
rm -f log/*.log tmp/local_secret.txt

amp_config_dir="$HOME/.config/amp"
mkdir -p "$amp_config_dir"
agents_file="$amp_config_dir/AGENTS.md"
agents_marker="# Inside the Writebook orb"
touch "$agents_file"
if ! grep -Fqx "$agents_marker" "$agents_file"; then
  cat >> "$agents_file" <<'EOF'

# Inside the Writebook orb

- Ruby 3.4.7 and the locked bundle are installed by `.agents/setup`.
- Run the application test suite with `bin/rails test`.
- Work directly in the repository and verify changes before finishing.
EOF
fi

echo "Orb setup complete."
